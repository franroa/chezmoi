{
  "env": {
    "CLAUDE_MEM_RUNTIME": "server-beta"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID 2>/dev/null; printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'setsid bash /home/froa/.claude/hooks/notify.sh \"Awaiting your input\" /home/froa/.claude/plugins/cache/claude-notifications-go/claude-notifications-go/1.38.0/sounds/question.mp3 > /dev/null 2>&1 &'"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/tmux-input.sh"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID 2>/dev/null; printf waiting > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/tmux-working.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode|EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash /tmp/debug-hook.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/tmux-working.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID 2>/dev/null; printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/froa/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'setsid bash /home/froa/.claude/hooks/notify.sh \"Task completed\" /home/froa/.claude/plugins/cache/claude-notifications-go/claude-notifications-go/1.38.0/sounds/task-complete.mp3 > /dev/null 2>&1 &'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/tmux-done.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID 2>/dev/null; printf idle > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/froa/.claude/hooks/tmux-working.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$AOE_INSTANCE_ID\" ] || exit 0; mkdir -p /tmp/aoe-hooks/$AOE_INSTANCE_ID 2>/dev/null; printf running > /tmp/aoe-hooks/$AOE_INSTANCE_ID/status 2>/dev/null; exit 0'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"/bin/python\" \"/home/froa/.claude/plugins/cache/yet-another-statusline/yas/0.2.0/claude/statusline_command.py\"",
    "refreshInterval": 1
  },
