[sandbox]
enabled_by_default = true
default_image = "ghcr.io/agent-of-empires/aoe-sandbox:latest"
auto_cleanup = true
memory_limit = "8g"

# Read-only shares of host Claude config that the agent never writes to.
# Writable config (settings.json, .claude.json, plugins/, sessions/) is left to
# AOE's sandbox-dir sync; mounting those RW would corrupt the host copy.
extra_volumes = [
  "{{ .chezmoi.homeDir }}/.claude/agents:/root/.claude/agents:ro",
  "{{ .chezmoi.homeDir }}/.claude/commands:/root/.claude/commands:ro",
]
