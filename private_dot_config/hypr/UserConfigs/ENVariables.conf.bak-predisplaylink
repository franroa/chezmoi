### NVIDIA ###
# This is from Hyprland Wiki. Below will be activated nvidia gpu detected
# See hyprland wiki https://wiki.hyprland.org/Nvidia/#environment-variables

env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = NVD_BACKEND,direct
env = GSK_RENDERER,ngl

# Intel iGPU (card1) = primary renderer, NVIDIA (card2) = DP/HDMI outputs
# NOTE: AQ_DRM_DEVICES splits on ALL colons — by-path PCI addresses break parsing, use cardN
# card1=Intel iGPU, card2=NVIDIA RTX 4060. evdi (card3+) excluded: no EGL → crash
env = AQ_DRM_DEVICES,/dev/dri/card1:/dev/dri/card2

### additional ENV's for nvidia. Caution, activate with care ###
env = WLR_NO_HARDWARE_CURSORS,1
# GBM_BACKEND=nvidia-drm breaks EVDI (DisplayLink) in Hyprland 0.55/aquamarine 0.7
# — aquamarine now uses GBM_BACKEND when initializing secondary GPU devices, and
#   nvidia-drm backend can't handle the evdi card fd → renderer init fails.
#   Modern NVIDIA drivers (520+) no longer need this forced backend.
#env = GBM_BACKEND,nvidia-drm
env = __NV_PRIME_RENDER_OFFLOAD,1
env = __NV_PRIME_RENDER_OFFLOAD_PROVIDER,NVIDIA-G0
env = __VK_LAYER_NV_optimus,NVIDIA_only
env = VK_ICD_FILENAMES,/usr/share/vulkan/icd.d/nvidia_icd.json
#env = __GL_GSYNC_ALLOWED,1 #adaptive Vsync
#env = WLR_DRM_NO_ATOMIC,1

