# Match Kitty appearance
font-family = "FantasqueSansM Nerd Font Mono"
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 16


font-feature = calt
font-feature = liga
font-feature = dlig

background-opacity = 0.75
# Apply opacity to cells with an explicit bg too (tmux/nvim repaint the bg on
# redraw/session-switch, which otherwise renders them fully opaque/black).
background-opacity-cells = false
confirm-close-surface = false

cursor-style = bar
cursor-color = #dddddd

window-padding-x = 4
window-padding-y = 4

scrollback-limit = 2000

foreground = #dddddd
background = #000000

# Shell
# command = fish -c "tmux new-session -A -s JIRA docker exec -it 70d jira issue list --jql 'project in (SDI2402, P0004) AND assignee = currentUser() AND status not in (\"Done\", \"Closed\", \"Resolved\")'"
command = fish -c "tmux attach-session -t default || tmux new-session -s default"
# Other settings
gtk-single-instance = true
mouse-hide-while-typing = true
shell-integration = fish
window-save-state = always
window-theme = dark

# Theme switching (optional): managed by your theme changer (symlink or generated file).
config-file = ?~/.config/ghostty/theme.conf

# Wallust (optional): wallust template should write Ghostty colors here; it will override theme colors.
config-file = ?~/.config/ghostty/wallust.conf
font-family = "Flog Symbols"
