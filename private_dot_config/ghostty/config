# Match Kitty appearance
font-family = "FantasqueSansM Nerd Font Mono"
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 16


font-feature = calt
font-feature = liga
font-feature = dlig

background-opacity = 0.75
confirm-close-surface = false

cursor-style = bar
cursor-color = #dddddd

window-padding-x = 4
window-padding-y = 4

scrollback-limit = 2000

foreground = #dddddd
background = #000000

# Shell
command = fish

# Other settings
gtk-single-instance = true
mouse-hide-while-typing = true
shell-integration = fish
window-save-state = always
window-theme = dark

# Theme switching (optional): managed by your theme changer (symlink or generated file).
config-file = ?~/.config/ghostty/theme.conf

# Wallust (optional): wallust template should write Ghostty colors here; it will override theme colors.
config-file = ?~/.config/ghostty/wallust.conf
font-family = "Flog Symbols"
