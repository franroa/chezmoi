#!/usr/bin/env fish
# which-key.fish - Hierarchical which-key plugin with clean menu transitions
# Each keypress clears the previous menu and shows the next level

set -gx __which_key_active 0
set -gx __which_key_prefix ""

# Define menu structure
function __which_key_init_menus
    set -gx __which_key_main_menu \
        "g" "Git commands" \
        "f" "FZF commands" \
        "k" "Kubectl commands" \
        "r" "Reload config"
    
    set -gx __which_key_git_menu \
        "b" "Branches" \
        "e" "Each ref" \
        "f" "Files" \
        "h" "Hashes" \
        "l" "Reflogs" \
        "r" "Remotes" \
        "s" "Stashes" \
        "t" "Tags" \
        "w" "Worktrees"
    
    set -gx __which_key_fzf_menu \
        "c" "CD directory" \
        "f" "File" \
        "h" "History" \
        "p" "Processes" \
        "s" "Git status" \
        "l" "Git log"
    
    set -gx __which_key_kubectl_menu \
        "g" "Get resources" \
        "d" "Describe resource" \
        "l" "View logs" \
        "a" "Apply manifest" \
        "e" "Edit resource" \
        "x" "Execute in pod" \
        "p" "Port forward" \
        "t" "Top (metrics)"
end

function __which_key_draw_menu
    set -l title $argv[1]
    set -l menu_items $argv[2..-1]
    
    # Clear and redraw just this menu
    clear
    printf '\n'
    
    # Calculate max width needed
    set -l max_width (string length "$title")
    set -l i 1
    while test $i -le (count $menu_items)
        set -l key $menu_items[$i]
        set -l desc $menu_items[(math $i + 1)]
        set -l line_len (math (string length "$key") + 2 + (string length "$desc"))
        if test $line_len -gt $max_width
            set max_width $line_len
        end
        set i (math $i + 2)
    end
    
    # Add padding for the borders
    set max_width (math $max_width + 4)
    
    # Draw top border
    set -l top_border "┌"
    set -l bottom_border "└"
    set -l i 0
    while test $i -lt $max_width
        set top_border "$top_border─"
        set bottom_border "$bottom_border─"
        set i (math $i + 1)
    end
    set top_border "$top_border┐"
    set bottom_border "$bottom_border┘"
    
    printf '%s\n' "$top_border"
    printf '│ '(set_color yellow)'%s'(set_color normal)'%*s │\n' "$title" (math $max_width - (string length "$title") - 2) ""
    
    # Draw menu items
    set -l i 1
    while test $i -le (count $menu_items)
        set -l key $menu_items[$i]
        set -l desc $menu_items[(math $i + 1)]
        printf '│ '(set_color yellow)'%s'(set_color normal)'  %s%*s │\n' "$key" "$desc" (math $max_width - (string length "$key") - 2 - (string length "$desc") - 2) ""
        set i (math $i + 2)
    end
    
    printf '%s\n' "$bottom_border"
    printf '\n'
end

function __which_key_show_menu
    set -l prefix $argv[1]
    set -l title ""
    set -l menu_items
    
    # Select menu based on prefix
    if test -z "$prefix"
        set title "Available Keys"
        set menu_items $__which_key_main_menu
    else if test "$prefix" = "g"
        set title "Git Commands"
        set menu_items $__which_key_git_menu
    else if test "$prefix" = "f"
        set title "FZF Commands"
        set menu_items $__which_key_fzf_menu
    else if test "$prefix" = "k"
        set title "Kubectl Commands"
        set menu_items $__which_key_kubectl_menu
    end
    
    __which_key_draw_menu "$title" $menu_items
end

function __which_key_process_key
    set -l prefix $argv[1]
    set -l key $argv[2]
    
    # ESC or 'q' always exits
    if test "$key" = "q" -o "$key" = (printf '\x1b')
        __which_key_exit
        return
    end
    
    # From root menu
    if test -z "$prefix"
        if test "$key" = "g"
            set -gx __which_key_prefix "g"
            __which_key_show_menu "g"
            return
        else if test "$key" = "f"
            set -gx __which_key_prefix "f"
            __which_key_show_menu "f"
            return
        else if test "$key" = "k"
            set -gx __which_key_prefix "k"
            __which_key_show_menu "k"
            return
        else if test "$key" = "r"
            __which_key_exit
            __reload_fish_config
            return
        else
            # Invalid key, stay at root
            __which_key_show_menu ""
            return
        end
    
    # From git menu
    else if test "$prefix" = "g"
        set -gx __which_key_prefix ""
        switch $key
            case "b"
                __which_key_exit
                __fzf_git_sh branches
            case "e"
                __which_key_exit
                __fzf_git_sh each_ref
            case "f"
                __which_key_exit
                __fzf_git_sh files
            case "h"
                __which_key_exit
                __fzf_git_sh hashes
            case "l"
                __which_key_exit
                __fzf_git_sh lreflogs
            case "r"
                __which_key_exit
                __fzf_git_sh remotes
            case "s"
                __which_key_exit
                __fzf_git_sh stashes
            case "t"
                __which_key_exit
                __fzf_git_sh tags
            case "w"
                __which_key_exit
                __fzf_git_sh worktrees
            case "*"
                # Invalid key, back to root
                set -gx __which_key_prefix ""
                __which_key_show_menu ""
        end
        return
    
    # From fzf menu
    else if test "$prefix" = "f"
        set -gx __which_key_prefix ""
        switch $key
            case "c"
                __which_key_exit
                fzf-cd-widget
            case "f"
                __which_key_exit
                fzf-file-widget
            case "h"
                __which_key_exit
                fzf-history-widget
            case "p"
                __which_key_exit
            case "s"
                __which_key_exit
            case "l"
                __which_key_exit
            case "*"
                # Invalid key, back to root
                set -gx __which_key_prefix ""
                __which_key_show_menu ""
        end
        return
    
    # From kubectl menu
    else if test "$prefix" = "k"
        set -gx __which_key_prefix ""
        switch $key
            case "g"
                __which_key_exit
                kubectl get all
            case "d"
                __which_key_exit
                printf '\nEnter resource type (e.g., pod, service, deployment): '
                read -l resource_type
                printf 'Enter resource name: '
                read -l resource_name
                kubectl describe $resource_type $resource_name
            case "l"
                __which_key_exit
                printf '\nEnter pod name: '
                read -l pod_name
                kubectl logs $pod_name
            case "a"
                __which_key_exit
                printf '\nEnter manifest file path: '
                read -l manifest_file
                kubectl apply -f $manifest_file
            case "e"
                __which_key_exit
                printf '\nEnter resource type (e.g., pod, service, deployment): '
                read -l resource_type
                printf 'Enter resource name: '
                read -l resource_name
                kubectl edit $resource_type $resource_name
            case "x"
                __which_key_exit
                printf '\nEnter pod name: '
                read -l pod_name
                printf 'Enter command to execute: '
                read -l command
                kubectl exec -it $pod_name -- $command
            case "p"
                __which_key_exit
                printf '\nEnter pod name: '
                read -l pod_name
                printf 'Enter local port: '
                read -l local_port
                printf 'Enter remote port: '
                read -l remote_port
                kubectl port-forward $pod_name $local_port:$remote_port
            case "t"
                __which_key_exit
                kubectl top nodes
            case "*"
                # Invalid key, back to root
                set -gx __which_key_prefix ""
                __which_key_show_menu ""
        end
        return
end

function __reload_fish_config --description "Reload all fish configuration files"
    clear
    printf '\n'
    
    # Calculate box width
    set -l text "Reloading config..."
    set -l box_width (math (string length "$text") + 4)
    
    # Draw top border
    set -l top_border "┌"
    set -l bottom_border "└"
    set -l i 0
    while test $i -lt $box_width
        set top_border "$top_border─"
        set bottom_border "$bottom_border─"
        set i (math $i + 1)
    end
    set top_border "$top_border┐"
    set bottom_border "$bottom_border┘"
    
    printf '%s\n' "$top_border"
    printf '│ '(set_color yellow)'%s'(set_color normal)'%*s │\n' "$text" (math $box_width - (string length "$text") - 2) ""
    printf '%s\n' "$bottom_border"
    printf '\n'
    
    # Source config.fish to reload everything
    source ~/.config/fish/config.fish 2>&1
    
    sleep 0.5
    clear
    printf '\n'
    
    # Draw success message
    set -l success_text "✓ Config reloaded"
    set -l box_width (math (string length "$success_text") + 4)
    
    set -l top_border "┌"
    set -l bottom_border "└"
    set -l i 0
    while test $i -lt $box_width
        set top_border "$top_border─"
        set bottom_border "$bottom_border─"
        set i (math $i + 1)
    end
    set top_border "$top_border┐"
    set bottom_border "$bottom_border┘"
    
    printf '%s\n' "$top_border"
    printf '│ '(set_color green)'%s'(set_color normal)'%*s │\n' "$success_text" (math $box_width - (string length "$success_text") - 2) ""
    printf '%s\n' "$bottom_border"
    printf '\n'
    
    sleep 1
    commandline -f repaint
end

function __which_key_exit
    set -gx __which_key_active 0
    set -gx __which_key_prefix ""
    commandline -f repaint
end

# Main which-key function that loops waiting for input
function which_key --description "Show interactive keybindings menu"
    if test $__which_key_active -eq 1
        return 1
    end
    
    set -gx __which_key_active 1
    set -gx __which_key_prefix ""
    
    # Show initial menu
    __which_key_show_menu ""
    
    # Read single character without waiting for enter
    while true
        stty -echo -icanon 2>/dev/null
        set -l key (dd bs=1 count=1 2>/dev/null)
        stty echo icanon 2>/dev/null
        
        if test -n "$key"
            __which_key_process_key $__which_key_prefix "$key"
        end
        
        # Check if we should exit
        if test $__which_key_active -eq 0
            break
        end
    end
end

# Wrapper function for vi normal mode space binding
function __which_key_vi_normal
    # Only trigger if we're in normal mode (not insert mode)
    if test "$fish_bind_mode" = "default"
        which_key
    else
        # In insert mode or other mode, just insert a space
        commandline -i ' '
    end
end

# Initialize menus
__which_key_init_menus

# Bind Space to trigger which-key in vi normal mode
bind -M default ' ' __which_key_vi_normal

# Bind Ctrl+R to reload config in both normal and insert modes
bind -M default '\cr' __reload_fish_config
bind -M insert '\cr' __reload_fish_config
