#!/usr/bin/env bash

client_term=$(tmux display-message -p '#{client_termname}' 2>/dev/null)
if [[ "$client_term" == foot* ]]; then
  exit 0
fi

# ONE tmux list-sessions call provides everything below (count, creation-time
# order, and the name->pane_path map). Was three separate forks into the server.
mapfile -t sess_lines < <(tmux list-sessions -F '#{session_created}	#{session_name}	#{pane_current_path}' 2>/dev/null)

if [ "${#sess_lines[@]}" -le 1 ]; then
  exit 0
fi

# $1 = the active session name, passed by status-left as #{client_session}.
# Passing it makes the #() command string change on every session switch, which
# busts tmux's job cache and re-runs this immediately (instead of waiting up to
# status-interval seconds) — that's what kills the focused-highlight lag. Falls
# back to a display-message lookup if not given.
current_session="${1:-$(tmux display-message -p '#{session_name}')}"
# Order by creation time, not name, so a new session is appended last and the
# alphabet letters of existing sessions stay stable. session-menu.sh MUST use
# the same ordering for click/jump indices to match.
all_sessions=$(printf '%s\n' "${sess_lines[@]}" | sort -s -n -k1,1 | cut -f2)

# Label mode (toggled by session-toggle.sh):
#   letters — abbreviate non-focused to a/b/c… (default), focused expands to name
#   names   — full names like before
#   both    — "<letter>-<name>" for every session
label_mode=""
[ -f /tmp/.claude-tmux-labelmode ] && label_mode=$(</tmp/.claude-tmux-labelmode)
case "$label_mode" in names|both) ;; *) label_mode=letters ;; esac

main_name=""
if [[ "$current_session" == *-T2 ]]; then
  main_name="${current_session%-T2}"
fi

# Spinner frame is time-based, shared by all working sessions.
# 2-row-tall braille (bottom rows only — no top dot): a 2-dot bar rotating.
spinner_frames=('⠆' '⠒' '⠰' '⠤')
now=$(date +%s)
frame_idx=$(( now % ${#spinner_frames[@]} ))
spinner_char="${spinner_frames[$frame_idx]}"

# Ensure the GitLab remote-pipeline poller is running (single instance, detached).
# gctui remote-poll writes /tmp/.claude-tmux-pipeline-* (same paths as the old
# glab-pipeline-poller.sh it replaces) and uses the same pidfile — no icon changes.
poller_pid=/tmp/.claude-tmux-pipeline-poller.pid
if ! { [ -f "$poller_pid" ] && kill -0 "$(cat "$poller_pid" 2>/dev/null)" 2>/dev/null; }; then
  setsid "$(command -v gctui || echo /home/froa/.local/bin/gctui)" remote-poll >/dev/null 2>&1 &
fi

# Ensure the gctui local-pipeline status poller is running (single instance). It
# mirrors the remote poller but reads gctui's durable ~/.cache/gctui run-state and
# writes /tmp/.claude-tmux-local-* render caches that local_icon() draws from.
local_poller_pid=/tmp/.claude-tmux-local-poller.pid
if ! { [ -f "$local_poller_pid" ] && kill -0 "$(cat "$local_poller_pid" 2>/dev/null)" 2>/dev/null; }; then
  setsid "$(command -v gctui || echo /home/froa/.local/bin/gctui)" tmux-poll >/dev/null 2>&1 &
fi

# Read Claude status for a given session name from its status file
session_status() {
  local s="$1"
  local f="/tmp/.claude-tmux-status-${s}"
  [ -f "$f" ] || return
  local raw
  raw=$(<"$f")
  case "$raw" in
    input) printf 'input' ;;     # waiting for user input  -> red blink
    done)  printf 'done' ;;      # finished the job        -> green blink
    working:*)
      local ts="${raw#working:}"
      [ $(( now - ts )) -lt 300 ] && printf 'working'
      ;;
  esac
}

# GitLab pipeline icon for a session, read from the poller's cache (keyed by
# the session's active pane path). Prints a tmux-styled icon or nothing.
# Takes the session's active pane path directly (precomputed once, see below) —
# avoids one `tmux display-message` fork per session on every status tick.
# Render the pipeline icon from a precomputed key (md5 of the pane path). The
# key is hashed once per session below and shared with the finished-marker check.
pipeline_icon() {
  local key="$1" st
  [ -z "$key" ] && return
  local cache="/tmp/.claude-tmux-pipeline-${key}"
  [ -f "$cache" ] || return
  st="$(<"$cache")"
  case "$st" in
    running)            printf ' #[fg=#89dceb]⟳' ;;
    success)            printf ' #[fg=#a6e3a1]✓' ;;
    failed)             printf ' #[fg=#f38ba8]✗' ;;
    pending|created|preparing|scheduled|waiting_for_resource) printf ' #[fg=#f9e2af]◌' ;;
    *)                  : ;;   # none / canceled / skipped / manual -> no icon
  esac
}

# gctui local-pipeline icon, read from the local poller's cache (same path key as
# the remote one). Uses the SAME glyphs as the remote pipeline_icon (⟳/✓/✗/◌) so
# a local run reads identically to a remote one; it sits just right of the remote
# icon, so position (not shape) tells them apart. Running shows ⟳ as soon as the
# poller sees the live job (icon changes while a pipeline runs).
local_icon() {
  local key="$1" st
  [ -z "$key" ] && return
  local cache="/tmp/.claude-tmux-local-${key}"
  [ -f "$cache" ] || return
  st="$(<"$cache")"
  case "$st" in
    running) printf ' #[fg=#89dceb]⟳' ;;
    success) printf ' #[fg=#a6e3a1]✓' ;;
    failed)  printf ' #[fg=#f38ba8]✗' ;;
    pending) printf ' #[fg=#f9e2af]◌' ;;
    *)       : ;;   # none -> no icon
  esac
}

# Map every session -> its active pane path, reusing the single list-sessions
# result captured at the top (no extra fork into the tmux server).
declare -A session_path
for _line in "${sess_lines[@]}"; do
  IFS=$'\t' read -r _c _sn _sp <<<"$_line"
  session_path["$_sn"]="$_sp"
done

output=""
alphabet=(a b c d e f g h i j k l m n o p q r s t u v w x y z)
letter_idx=0
range_idx=0
for session in $all_sessions; do
  if [[ "$session" == *-T2 ]]; then
    continue
  fi

  if [[ "$session" =~ ^[0-9]+$ ]]; then
    continue
  fi

  # Display label: hide "aoe_" prefix and trailing "_<hash>" suffix.
  # Pure bash (no sed fork per session).
  label="${session#aoe_}"
  [[ "$label" =~ ^(.+)_[0-9a-f]+$ ]] && label="${BASH_REMATCH[1]}"

  # Per-session Claude status (works regardless of focus)
  status=$(session_status "$session")

  is_focused=0
  if [ "$session" = "$current_session" ] || [ "$session" = "$main_name" ]; then
    is_focused=1
  fi

  # Label text depends on the mode; focus only changes color/weight (except in
  # "letters" mode, where focus also expands the letter back to the full name).
  letter="${alphabet[$letter_idx]:-?}"
  case "$label_mode" in
    names) display_label="$label" ;;
    both)  display_label="${letter}-${label}" ;;
    *)     [ "$is_focused" = 1 ] && display_label="$label" || display_label="$letter" ;;
  esac

  if [ "$is_focused" = 1 ]; then
    bg="#7aa2f7"
    attr=",bold"
  else
    bg="#9d989f"
    attr=""
  fi

  # Spinner lives inside the block, sharing the session's background
  spinner=""
  if [ "$status" = "working" ]; then
    spinner="#[fg=#f38ba8,bold]${spinner_char}#[fg=#1a1b26] "
  fi

  # Acknowledge on focus: only the "done" (green) state clears on focus.
  # "input" (red) means Claude still needs a choice — focusing doesn't answer
  # it, so it keeps blinking until Claude resumes (a working write overwrites).
  if [ "$status" = "done" ] && [ "$is_focused" = 1 ]; then
    rm -f "/tmp/.claude-tmux-status-${session}"
    status=""
  fi

  # Pipeline-finished pink blink: the poller drops this marker when a pipeline
  # goes active -> terminal. Blinks until the session is focused (then cleared).
  pl_path="${session_path[$session]:-}"
  pl_key=""
  [ -n "$pl_path" ] && pl_key="$(printf '%s' "$pl_path" | md5sum | cut -c1-16)"
  pl_finished=0
  if [ -n "$pl_key" ] && [ -f "/tmp/.claude-tmux-pipeline-finished-${pl_key}" ]; then
    if [ "$is_focused" = 1 ]; then
      rm -f "/tmp/.claude-tmux-pipeline-finished-${pl_key}"
    else
      pl_finished=1
    fi
  fi

  # Local-pipeline-finished yellow blink: same active -> terminal marker mechanism
  # as remote, dropped by `gctui tmux-poll`. Distinct color (yellow vs the remote
  # pink) so a local run finishing reads differently from a remote pipeline.
  loc_finished=0
  if [ -n "$pl_key" ] && [ -f "/tmp/.claude-tmux-local-finished-${pl_key}" ]; then
    if [ "$is_focused" = 1 ]; then
      rm -f "/tmp/.claude-tmux-local-finished-${pl_key}"
    else
      loc_finished=1
    fi
  fi

  # Manual blink: ghostty ignores the SGR blink attr, so pulse the background
  # color each second (same redraw trick as spinner).
  #   red    = waiting for user input
  #   green  = finished the job
  #   pink   = REMOTE GitLab pipeline just finished (success or failed)
  #   yellow = LOCAL pipeline/job just finished (gctui)
  if [ $(( now % 2 )) -eq 0 ]; then
    if [ "$status" = "input" ]; then
      bg="#f38ba8"
    elif [ "$status" = "done" ]; then
      bg="#a6e3a1"
    elif [ "$pl_finished" = 1 ]; then
      bg="#f5c2e7"
    elif [ "$loc_finished" = 1 ]; then
      bg="#f9e2af"
    fi
  fi

  # GitLab pipeline icon (remote) + gctui local icon, right of the session name.
  icon="$(pipeline_icon "$pl_key")"
  licon="$(local_icon "$pl_key")"

  # Wrap block in a clickable range. mouse_status_range = range_idx on click;
  # session-menu.sh maps the index back to the session name (names can exceed
  # the 15-byte range=user|X cap, so index is used instead).
  # Range value is prefixed with "s" so it is never the bare string "0" — tmux's
  # `if-shell -F` guard treats "0" (and empty) as false, which silently swallowed
  # clicks on the first element. session-menu.sh strips the prefix back off.
  output+="#[range=user|s${range_idx}]#[bg=${bg},fg=#1a1b26${attr}] ${spinner}${display_label}${icon}${licon} #[norange]#[default] "
  range_idx=$((range_idx + 1))
  letter_idx=$((letter_idx + 1))
done

printf '%s' "$output"
