<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Common vstest run settings -->
  
  <!-- Test Execution Settings -->
  <RunConfiguration>
    <!-- Enable parallel test execution -->
    <MaxCpuCount>0</MaxCpuCount>
    <!-- 0 = use all available cores, >0 = specific number -->
    
    <!-- Test execution timeout in milliseconds -->
    <TestSessionTimeout>0</TestSessionTimeout>
    <!-- 0 = no timeout -->
    
    <!-- Working directory for tests -->
    <ResultsDirectory>.\TestResults</ResultsDirectory>
  </RunConfiguration>

  <!-- Logging Settings -->
  <LoggerRunSettings>
    <!-- Set verbosity for test execution logging -->
    <!-- Possible values: quiet, minimal, normal, detailed, verbose -->
    <Verbosity>normal</Verbosity>
  </LoggerRunSettings>

  <!-- MSTest Specific Settings -->
  <MSTest>
    <!-- Enable parallel test execution for MSTest -->
    <Parallelize workers="0" scope="MethodLevel"/>
    <!-- workers: 0 = auto-detect, scope: MethodLevel or ClassLevel -->
    
    <!-- Test execution timeout in milliseconds -->
    <TestTimeoutInMs>0</TestTimeoutInMs>
    <!-- 0 = no timeout -->
    
    <!-- Enable assertions in method attributes -->
    <AssemblyResolution>
      <Directory path="bin\Debug" includeSubDirectories="true"/>
    </AssemblyResolution>
  </MSTest>

  <!-- NUnit Specific Settings (if using NUnit) -->
  <NUnit>
    <NumberOfTestWorkers>0</NumberOfTestWorkers>
    <!-- 0 = auto-detect -->
  </NUnit>

  <!-- xUnit Specific Settings (if using xUnit) -->
  <xUnit>
    <MaxParallelThreads>0</MaxParallelThreads>
    <!-- 0 = auto-detect -->
  </xUnit>

  <!-- Code Coverage Settings -->
  <CodeCoverage>
    <Enabled>false</Enabled>
    <!-- Enable if you want code coverage reports -->
  </CodeCoverage>

</RunSettings>
