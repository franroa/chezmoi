# Pyprland Configuration
# Documentation: https://hyprland-community.github.io/pyprland/

[pyprland]
plugins = [
    "scratchpads",
    "expose",
    "magnify",
    "shift_monitors",
    "toggle_dpms",
    "toggle_special",
    "fetch_client_menu",
    "lost_windows",
    "layout_center",
    "shortcuts_menu",
]

[scratchpads.term]
animation = ""
command = "foot --app-id=foot-dropterm fish"
class = "foot-dropterm"
process_tracking = false
size = "85% 85%"
position = "7% 7%"
unfocus = "hide"

[scratchpads.btop]
animation = ""
command = "foot --app-id=foot-btop fish -c btop"
class = "foot-btop"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.files]
animation = ""
command = "nautilus --new-window"
class = "org.gnome.Nautilus"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.volume]
animation = ""
command = "pavucontrol"
class = "org.pulseaudio.pavucontrol"
process_tracking = false
size = "85% 85%"
position = "7% 7%"
unfocus = "hide"

[scratchpads.music]
animation = ""
command = "spotify"
class = "Spotify"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.calc]
animation = ""
command = "gnome-calculator"
class = "org.gnome.Calculator"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.keepassxc]
animation = ""
command = "keepassxc"
class = "org.keepassxc.KeePassXC"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.gpt]
animation = ""
command = "firefox --new-window https://chat.openai.com"
class = "firefox"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

[scratchpads.notes]
animation = ""
command = "obsidian"
class = "obsidian"
process_tracking = false
size = "85% 85%"
position = "7% 7%"

