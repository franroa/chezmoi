# ============================================================================
# EXPOSE - Show all windows on current workspace
# ============================================================================

[expose]
include_special = false

# ============================================================================
# MAGNIFY - Zoom the screen
# ============================================================================

[magnify]
factor = 2.0

# ============================================================================
# SHIFT MONITORS - Swap workspaces between monitors
# ============================================================================

[shift_monitors]
# No config needed, uses direction argument

# ============================================================================
# TOGGLE DPMS - Turn screens on/off
# ============================================================================

[toggle_dpms]
# No config needed

# ============================================================================
# TOGGLE SPECIAL - Minimize windows to special workspace
# ============================================================================

[toggle_special]
# Default workspace name for minimized windows
name = "minimized"

# ============================================================================
# FETCH CLIENT MENU - Pick a window from another workspace
# ============================================================================

[fetch_client_menu]
# Menu engine (auto-detected if not set)
# engine = "rofi"
separator = " | "
# Exclude scratchpads from menu
filter_by_workspace = false

# ============================================================================
# LOST WINDOWS - Find floating windows off-screen
# ============================================================================

[lost_windows]
# No config needed

# ============================================================================
# LAYOUT CENTER - Center the focused window
# ============================================================================

[layout_center]
margin = 60
offset = [0, 0]
next = "+1"
prev = "-1"

# ============================================================================
# SHORTCUTS MENU - Custom command menus
# ============================================================================

[shortcuts_menu]
engine = "rofi"

[shortcuts_menu.entries.apps]
"󰈹 Firefox" = "firefox"
"󰊯 Chrome" = "google-chrome"
"󰉋 Files" = "nautilus"
"󰆍 Terminal" = "foot"
"󰨞 VSCode" = "code"
" Obsidian" = "obsidian"
"󰓇 Spotify" = "spotify"

[shortcuts_menu.entries.power]
"󰌾 Lock" = "hyprlock"
"󰤄 Suspend" = "systemctl suspend"
"󰜉 Reboot" = "systemctl reboot"
"󰐥 Shutdown" = "systemctl poweroff"
"󰗼 Logout" = "hyprctl dispatch exit"

[shortcuts_menu.entries.clipboard]
"󰅍 History" = "cliphist list | rofi -dmenu | cliphist decode | wl-copy"
"󰆒 Clear" = "cliphist wipe"
