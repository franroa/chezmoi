            # Tab cycles forward
            bindsym Tab exec python3 ~/.config/sway/alt-tab.py next
            bindsym Mod1+Tab exec python3 ~/.config/sway/alt-tab.py next
            
            # Shift+Tab cycles backward
            bindsym Shift+Tab exec python3 ~/.config/sway/alt-tab.py prev
            bindsym Mod1+Shift+Tab exec python3 ~/.config/sway/alt-tab.py prev
            
            # Escape cancels
            bindsym Escape exec python3 ~/.config/sway/alt-tab.py cancel
        }


