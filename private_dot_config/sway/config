# Auto-mark previously focused for quick switch + auto-focus new windows
# NOTE: Using 'exec' not 'exec_always' to avoid spawning duplicates on reload
    exec swaymsg -t subscribe -m '["window"]' | while read -r event; do \
        change=$(echo "$event" | jq -r '.change'); \
        if [ "$change" = "new" ]; then \
            con_id=$(echo "$event" | jq -r '.container.id'); \
            sleep 0.1; \
            swaymsg "[con_id=$con_id]" focus; \
        fi; \
        swaymsg '[con_mark="_prev"]' unmark "_prev" 2>/dev/null; \
        swaymsg mark --add "_prev"; \
    done &
