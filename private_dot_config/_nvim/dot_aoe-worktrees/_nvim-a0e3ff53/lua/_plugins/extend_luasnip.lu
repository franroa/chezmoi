  --   --       active = {
  --   --         virt_text = { { "●", "PortalBlue" } },
  --   --         hl_mode = "combine",
  --   --       },
  --   --     },
  --   --   }
  --   -- end,
  --   keys = function()
  --     return {}
  --   end,
  -- },
}
